{
	"version": "0.0.1",
	"configurations": [
		{
			"name": "web-demo",
			"runtimeExecutable": "pnpm",
			"runtimeArgs": [
				"--filter",
				"@strandbeest/web-demo",
				"dev",
				"--port",
				"5173"
			],
			"port": 5173
		},
		{
			"name": "web-demo-static",
			"runtimeExecutable": "bash",
			"runtimeArgs": [
				"-c",
				"cd apps/web-demo && VITE_STATIC=1 npx vite --port 5174"
			],
			"port": 5174
		}
	]
}
