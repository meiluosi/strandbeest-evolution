{
	"$schema": "https://json-schema.org/draft/2020-12/schema",
	"$id": "https://github.com/meiluosi/strandbeest-evolution/schemas/measurement.schema.json",
	"title": "Measurement",
	"description": "Time series measured on a physical build (or synthetic data, marked as such) under stated conditions.",
	"type": "object",
	"required": [
		"schema_version",
		"id",
		"design_name",
		"synthetic",
		"conditions",
		"channels"
	],
	"additionalProperties": false,
	"properties": {
		"schema_version": {
			"const": 1
		},
		"id": {
			"type": "string",
			"minLength": 1
		},
		"design_name": {
			"type": "string"
		},
		"synthetic": {
			"type": "boolean",
			"description": "true if generated by a simulator rather than measured"
		},
		"build_note": {
			"type": "string"
		},
		"conditions": {
			"type": "object",
			"required": ["kind"],
			"additionalProperties": false,
			"properties": {
				"kind": {
					"enum": ["motor_no_wind", "fan"]
				},
				"omega_rad_s": {
					"type": "number"
				},
				"wind_m_s": {
					"type": "number",
					"minimum": 0
				},
				"surface": {
					"type": "string"
				},
				"slope_deg": {
					"type": "number"
				}
			}
		},
		"channels": {
			"type": "object",
			"description": "equal-length arrays; t (s) is required. psi = crank rotation in the walking direction (rad), torque in N\u00b7m, x = body forward position (m).",
			"required": ["t"],
			"additionalProperties": {
				"type": "array",
				"items": {
					"type": "number"
				}
			},
			"properties": {
				"t": {
					"type": "array",
					"items": {
						"type": "number"
					},
					"minItems": 2
				}
			}
		},
		"provenance": {
			"type": "object",
			"additionalProperties": false,
			"description": "Where the numbers came from: the test rig (with its calibration) or another source.",
			"properties": {
				"source": {
					"enum": ["rig", "manual", "simulator"]
				},
				"rig_version": {
					"type": "string"
				},
				"calibration": {
					"type": "object"
				},
				"raw_file": {
					"type": "string"
				},
				"notes": {
					"type": "string"
				}
			}
		},
		"quality": {
			"type": "object",
			"additionalProperties": false,
			"description": "Automatic checks computed when the raw data were converted. Warnings are for a human to read before trusting a fit.",
			"properties": {
				"sample_rate_hz": {
					"type": "number"
				},
				"duration_s": {
					"type": "number"
				},
				"revolutions": {
					"type": "number"
				},
				"speed_mean_rad_s": {
					"type": "number"
				},
				"speed_cv": {
					"type": "number",
					"description": "std/mean of crank speed over 0.1 s windows"
				},
				"dropouts": {
					"type": "integer"
				},
				"time_offset_s": {
					"type": ["number", "null"],
					"description": "offset applied when aligning video tracking to the encoder clock"
				},
				"warnings": {
					"type": "array",
					"items": {
						"type": "string"
					}
				}
			}
		}
	}
}
