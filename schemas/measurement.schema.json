{
	"$schema": "https://json-schema.org/draft/2020-12/schema",
	"$id": "https://github.com/meiluosi/strandbeest-evolution/schemas/measurement.schema.json",
	"title": "Measurement",
	"description": "Time series measured on a physical build (or synthetic data, marked as such) under stated conditions.",
	"type": "object",
	"required": [
		"schema_version",
		"id",
		"design_name",
		"synthetic",
		"conditions",
		"channels"
	],
	"additionalProperties": false,
	"properties": {
		"schema_version": { "const": 1 },
		"id": { "type": "string", "minLength": 1 },
		"design_name": { "type": "string" },
		"synthetic": {
			"type": "boolean",
			"description": "true if generated by a simulator rather than measured"
		},
		"build_note": { "type": "string" },
		"conditions": {
			"type": "object",
			"required": ["kind"],
			"additionalProperties": false,
			"properties": {
				"kind": { "enum": ["motor_no_wind", "fan"] },
				"omega_rad_s": { "type": "number" },
				"wind_m_s": { "type": "number", "minimum": 0 },
				"surface": { "type": "string" },
				"slope_deg": { "type": "number" }
			}
		},
		"channels": {
			"type": "object",
			"description": "equal-length arrays; t (s) is required. psi = crank rotation in the walking direction (rad), torque in N·m, x = body forward position (m).",
			"required": ["t"],
			"additionalProperties": {
				"type": "array",
				"items": { "type": "number" }
			},
			"properties": {
				"t": { "type": "array", "items": { "type": "number" }, "minItems": 2 }
			}
		}
	}
}
