{
	"$schema": "https://json-schema.org/draft/2020-12/schema",
	"$id": "https://github.com/meiluosi/strandbeest-evolution/schemas/profile.schema.json",
	"title": "Profile",
	"description": "A calibrated parameter set with its provenance. Scenarios refer to it by name.",
	"type": "object",
	"required": ["schema_version", "name", "parameters", "provenance"],
	"additionalProperties": false,
	"properties": {
		"schema_version": { "const": 1 },
		"name": { "type": "string", "minLength": 1 },
		"parameters": {
			"type": "object",
			"minProperties": 1,
			"additionalProperties": { "type": "number" }
		},
		"provenance": {
			"type": "object",
			"required": ["measurement_ids", "method", "residual"],
			"additionalProperties": false,
			"properties": {
				"measurement_ids": {
					"type": "array",
					"items": { "type": "string" },
					"minItems": 1
				},
				"synthetic": { "type": "boolean" },
				"method": { "type": "string" },
				"residual": {
					"type": "number",
					"description": "fit error in the units of the compared quantity"
				},
				"code_version": { "type": "string" }
			}
		}
	}
}
