{
	"$schema": "https://json-schema.org/draft/2020-12/schema",
	"$id": "https://github.com/meiluosi/strandbeest-evolution/schemas/design.schema.json",
	"title": "Design",
	"description": "A walker: linkage geometry, scale, drive and manufacturing parameters. The single source for kinematics, evolution, simulation and fabrication.",
	"type": "object",
	"required": [
		"schema_version",
		"name",
		"linkage",
		"walker",
		"drive",
		"manufacturing"
	],
	"additionalProperties": false,
	"properties": {
		"schema_version": {
			"const": 1
		},
		"name": {
			"type": "string",
			"minLength": 1
		},
		"notes": {
			"type": "string"
		},
		"linkage": {
			"type": "object",
			"description": "A LinkageSpec as exported by packages/core: named lengths, crank, and joints defined as circle intersections.",
			"required": ["params", "crank", "joints", "foot"],
			"additionalProperties": false,
			"properties": {
				"params": {
					"type": "object",
					"additionalProperties": {
						"type": "number",
						"exclusiveMinimum": 0
					},
					"minProperties": 1
				},
				"crank": {
					"type": "object",
					"required": ["x", "y", "length"],
					"additionalProperties": false,
					"properties": {
						"x": {
							"$ref": "#/$defs/ref"
						},
						"y": {
							"$ref": "#/$defs/ref"
						},
						"length": {
							"$ref": "#/$defs/ref"
						}
					}
				},
				"joints": {
					"type": "array",
					"minItems": 1,
					"items": {
						"type": "object",
						"required": ["id", "centers", "radii", "side"],
						"additionalProperties": false,
						"properties": {
							"id": {
								"type": "string",
								"minLength": 1
							},
							"centers": {
								"type": "array",
								"items": {
									"type": "string"
								},
								"minItems": 2,
								"maxItems": 2
							},
							"radii": {
								"type": "array",
								"items": {
									"$ref": "#/$defs/ref"
								},
								"minItems": 2,
								"maxItems": 2
							},
							"side": {
								"enum": [1, -1]
							}
						}
					}
				},
				"foot": {
					"type": "string"
				}
			}
		},
		"walker": {
			"type": "object",
			"required": ["legs", "unit_m", "direction", "body_mass_kg"],
			"additionalProperties": false,
			"properties": {
				"legs": {
					"type": "integer",
					"minimum": 1
				},
				"unit_m": {
					"type": "number",
					"exclusiveMinimum": 0,
					"description": "metres per length unit of the linkage"
				},
				"direction": {
					"enum": [-1, 1],
					"description": "crank turning sense that walks the leg forward"
				},
				"body_mass_kg": {
					"type": "number",
					"exclusiveMinimum": 0,
					"description": "frame, motor and payload; excludes the legs"
				},
				"lateral_spacing_m": {
					"type": "number",
					"minimum": 0
				},
				"body_length_m": {
					"type": "number",
					"exclusiveMinimum": 0
				}
			}
		},
		"drive": {
			"type": "object",
			"required": ["kind"],
			"additionalProperties": false,
			"properties": {
				"kind": {
					"enum": ["motor", "sail"]
				},
				"motor_omega_rad_s": {
					"type": "number"
				},
				"sail": {
					"type": "object",
					"additionalProperties": false,
					"properties": {
						"area_m2": {
							"type": "number",
							"exclusiveMinimum": 0
						},
						"radius_m": {
							"type": "number",
							"exclusiveMinimum": 0
						},
						"drag_coeff": {
							"type": "number",
							"exclusiveMinimum": 0
						},
						"gear": {
							"type": "number",
							"exclusiveMinimum": 0
						},
						"inertia_kg_m2": {
							"type": "number",
							"minimum": 0
						},
						"damping_nm_s": {
							"type": "number",
							"minimum": 0
						},
						"friction_nm": {
							"type": "number",
							"minimum": 0
						}
					}
				}
			}
		},
		"manufacturing": {
			"type": "object",
			"required": [
				"process",
				"material",
				"bar_width_mm",
				"bar_thickness_mm",
				"pin_diameter_mm",
				"clearance_mm"
			],
			"additionalProperties": false,
			"properties": {
				"process": {
					"enum": ["fdm"]
				},
				"material": {
					"enum": ["PLA", "PETG"]
				},
				"bar_width_mm": {
					"type": "number",
					"exclusiveMinimum": 0
				},
				"bar_thickness_mm": {
					"type": "number",
					"exclusiveMinimum": 0
				},
				"pin_diameter_mm": {
					"type": "number",
					"exclusiveMinimum": 0,
					"description": "nominal pin or bolt diameter"
				},
				"clearance_mm": {
					"type": "number",
					"minimum": 0,
					"description": "added to the hole diameter"
				},
				"layer_height_mm": {
					"type": "number",
					"exclusiveMinimum": 0
				},
				"min_wall_mm": {
					"type": "number",
					"exclusiveMinimum": 0
				},
				"bed_mm": {
					"type": "array",
					"items": {
						"type": "number",
						"exclusiveMinimum": 0
					},
					"minItems": 2,
					"maxItems": 2
				},
				"press_fit_offset_mm": {
					"type": "number",
					"description": "added to a shaft diameter for holes that must grip (negative = tighter); FDM holes print small, tune after a test print"
				},
				"leg_gap_mm": {
					"type": "number",
					"minimum": 0,
					"description": "clearance between neighbouring legs along the axles"
				},
				"motor": {
					"type": "object",
					"additionalProperties": false,
					"description": "small gear motor mounted behind a frame plate; a hole pattern assumption for N20-class motors",
					"properties": {
						"shaft_diameter_mm": {
							"type": "number",
							"exclusiveMinimum": 0
						},
						"mount_hole_spacing_mm": {
							"type": "number",
							"exclusiveMinimum": 0
						},
						"mount_hole_diameter_mm": {
							"type": "number",
							"exclusiveMinimum": 0
						}
					}
				}
			}
		}
	},
	"$defs": {
		"ref": {
			"description": "a number, or the name of an entry in linkage.params",
			"oneOf": [
				{
					"type": "number"
				},
				{
					"type": "string"
				}
			]
		}
	}
}
