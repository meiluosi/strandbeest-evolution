{
	"$schema": "https://json-schema.org/draft/2020-12/schema",
	"$id": "https://github.com/meiluosi/strandbeest-evolution/schemas/run.schema.json",
	"title": "Run",
	"description": "Metadata and metrics of one simulation run. Time series live next to it in an arrays file.",
	"type": "object",
	"required": [
		"schema_version",
		"id",
		"design_name",
		"scenario",
		"metrics",
		"provenance"
	],
	"additionalProperties": false,
	"properties": {
		"schema_version": {
			"const": 1
		},
		"id": {
			"type": "string",
			"minLength": 1
		},
		"design_name": {
			"type": "string"
		},
		"scenario": {
			"type": "object",
			"description": "the fully resolved scenario that was run"
		},
		"metrics": {
			"type": "object",
			"additionalProperties": {
				"type": ["number", "boolean", "null"]
			}
		},
		"stalled": {
			"type": "boolean"
		},
		"arrays_file": {
			"type": "string"
		},
		"provenance": {
			"type": "object",
			"required": ["code_version"],
			"additionalProperties": false,
			"properties": {
				"code_version": {
					"type": "string"
				},
				"engine": {
					"type": "string"
				},
				"engine_version": {
					"type": "string"
				},
				"created": {
					"type": "string"
				}
			}
		},
		"ensemble": {
			"type": "object",
			"description": "Same scenario re-run under several friction-regularisation settings (docs/EXPERIMENTS.md section 8). Torque level depends on these numerical choices, so report ranges, not single numbers.",
			"required": ["variants", "ranges", "note"],
			"additionalProperties": false,
			"properties": {
				"variants": {
					"type": "array",
					"items": {
						"type": "object",
						"required": ["name", "valid", "metrics"],
						"additionalProperties": false,
						"properties": {
							"name": {
								"type": "string"
							},
							"overrides": {
								"type": "object"
							},
							"valid": {
								"type": "boolean"
							},
							"reason": {
								"type": "string"
							},
							"metrics": {
								"type": "object",
								"additionalProperties": {
									"type": ["number", "boolean", "null"]
								}
							}
						}
					}
				},
				"ranges": {
					"type": "object",
					"additionalProperties": {
						"type": "array",
						"items": {
							"type": "number"
						},
						"minItems": 2,
						"maxItems": 2
					}
				},
				"note": {
					"type": "string"
				}
			}
		}
	}
}
