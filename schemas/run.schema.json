{
	"$schema": "https://json-schema.org/draft/2020-12/schema",
	"$id": "https://github.com/meiluosi/strandbeest-evolution/schemas/run.schema.json",
	"title": "Run",
	"description": "Metadata and metrics of one simulation run. Time series live next to it in an arrays file.",
	"type": "object",
	"required": [
		"schema_version",
		"id",
		"design_id",
		"scenario",
		"metrics",
		"provenance"
	],
	"additionalProperties": false,
	"properties": {
		"schema_version": {
			"const": 2
		},
		"id": {
			"$ref": "#/$defs/Ulid"
		},
		"design_id": {
			"$ref": "#/$defs/Ulid"
		},
		"design_name": {
			"type": "string",
			"x-doc": {
				"zh": "运行时设计的名字（只是显示用的快照）",
				"en": "The design's name at run time (a display snapshot only)"
			}
		},
		"scenario": {
			"type": "object",
			"description": "the fully resolved scenario that was run"
		},
		"metrics": {
			"type": "object",
			"properties": {
				"energy_contact_normal_share": {
					"type": ["number", "null"],
					"x-unit": "1",
					"x-doc": {
						"zh": "法向接触有向能量转移占输入功的比例；穿透修正注入能量时可为负，与总接触功使用相同统计窗口",
						"en": "Signed normal contact transfer divided by input work over the same energy window; stabilization injection may be negative"
					}
				},
				"energy_contact_tangent_share": {
					"type": ["number", "null"],
					"x-unit": "1",
					"x-doc": {
						"zh": "切向接触有向能量转移占输入功的比例；冲量后滑移速度为零仍可能存在能量损失",
						"en": "Signed tangent contact transfer divided by input work; a sticking impulse can remove energy even when final slip is zero"
					}
				},
				"energy_numerical_share": {
					"type": ["number", "null"],
					"x-unit": "1",
					"x-doc": {
						"zh": "积分方法引入的有向机械能变化占输入功的比例，仅供诊断，禁止用于抵消能量审计残差；缺失不代表零",
						"en": "Signed mechanical energy change introduced by integration divided by input work; diagnostic only, never offsets the audit residual; absence does not mean zero"
					}
				}
			},
			"additionalProperties": {
				"type": ["number", "boolean", "null"],
				"x-unit": "1"
			}
		},
		"stalled": {
			"type": "boolean"
		},
		"arrays_file": {
			"type": "string",
			"x-doc": {
				"zh": "原始时间序列路径；K2可选列e_contact_normal、e_contact_tangent为累计有向接触转移，e_numerical为累计积分能量误差，单位均为J；后者不抵消审计残差。NPZ/Parquet及遥测保留符号，缺失列不补零",
				"en": "Raw time-series path. Optional K2 columns e_contact_normal and e_contact_tangent are cumulative signed contact transfers; e_numerical is cumulative integration energy error, all in J. Numerical error never offsets audit residuals. NPZ/Parquet and telemetry preserve signs; missing columns are not filled with zero"
			}
		},
		"parquet_file": {
			"type": "string"
		},
		"frames_parquet_file": {
			"type": "string"
		},
		"provenance": {
			"type": "object",
			"required": ["code_version"],
			"additionalProperties": false,
			"properties": {
				"code_version": {
					"type": "string"
				},
				"engine": {
					"type": "string"
				},
				"engine_version": {
					"type": "string"
				},
				"created": {
					"type": "string"
				},
				"input_key": {
					"type": "string",
					"pattern": "^sha256:[0-9a-f]{64}$"
				},
				"design_hash": {
					"type": "string",
					"pattern": "^sha256:[0-9a-f]{64}$"
				},
				"world_hash": {
					"type": "string",
					"pattern": "^sha256:[0-9a-f]{64}$"
				},
				"platform": {
					"type": "string"
				},
				"seed": {
					"type": "integer",
					"x-unit": "1"
				},
				"cache_hit_from": {
					"$ref": "#/$defs/Ulid"
				},
				"execution_identity": {
					"$ref": "#/$defs/ExecutionIdentity",
					"x-doc": {
						"zh": "实际执行实现的身份；旧运行缺省，禁止用当前版本补写。",
						"en": "Identity of the executed implementation; absent in legacy runs and never backfilled from the current build."
					}
				},
				"calibration_profile_id": {
					"$ref": "#/$defs/Ulid",
					"x-doc": {
						"zh": "本次仿真实际应用的校准档案 ID。",
						"en": "ID of the calibration Profile actually applied in this run."
					}
				}
			}
		},
		"ensemble": {
			"type": "object",
			"description": "Same scenario re-run under several friction-regularisation settings (docs/EXPERIMENTS.md section 8). Torque level depends on these numerical choices, so report ranges, not single numbers.",
			"required": ["variants", "ranges", "note"],
			"additionalProperties": false,
			"properties": {
				"variants": {
					"type": "array",
					"items": {
						"type": "object",
						"required": ["name", "valid", "metrics"],
						"additionalProperties": false,
						"properties": {
							"name": {
								"type": "string"
							},
							"overrides": {
								"type": "object"
							},
							"valid": {
								"type": "boolean"
							},
							"reason": {
								"type": "string"
							},
							"metrics": {
								"type": "object",
								"additionalProperties": {
									"type": ["number", "boolean", "null"],
									"x-unit": "1"
								}
							}
						}
					}
				},
				"ranges": {
					"type": "object",
					"additionalProperties": {
						"type": "array",
						"items": {
							"type": "number",
							"x-unit": "1"
						},
						"minItems": 2,
						"maxItems": 2
					}
				},
				"note": {
					"type": "string"
				}
			}
		},
		"frames_file": {
			"type": "string",
			"description": "recorded body poses for replay (npz)"
		},
		"scene_file": {
			"type": "string",
			"description": "scene geometry for replay (json)"
		},
		"aliases": {
			"type": "array",
			"items": {
				"type": "string"
			},
			"x-doc": {
				"zh": "旧名字或旧 ID；指向它们的引用都解析到这个资产",
				"en": "Former names or ids; a reference to any of them resolves to this asset"
			}
		},
		"events": {
			"type": "array",
			"description": "Facts with a time: foot touchdown/liftoff/slip, torque limit, loop opening, start, stall, gusts",
			"items": {
				"type": "object",
				"required": ["t", "kind"],
				"additionalProperties": false,
				"properties": {
					"t": {
						"type": "number",
						"x-unit": "s",
						"description": "time since the start of driving"
					},
					"kind": {
						"type": "string"
					},
					"leg": {
						"type": "integer",
						"minimum": 0,
						"x-unit": "count"
					},
					"detail": {
						"type": "object"
					}
				}
			}
		},
		"diagnosis": {
			"type": "array",
			"description": "Rule-based explanation of how the run went, best explanation first, with the numbers that support it",
			"items": {
				"type": "object",
				"required": ["code", "severity", "message", "evidence"],
				"additionalProperties": false,
				"properties": {
					"code": {
						"type": "string"
					},
					"severity": {
						"enum": ["info", "warning", "error"]
					},
					"message": {
						"type": "string"
					},
					"evidence": {
						"type": "object"
					}
				}
			}
		},
		"evidence": {
			"type": "object",
			"description": "Evidence level (E0-E3) and verification basis for the run metrics (docs/VALIDATION.md). Defaults to E0.",
			"required": ["level"],
			"additionalProperties": false,
			"properties": {
				"level": {
					"type": "string",
					"enum": ["E0", "E1", "E2", "E3"],
					"default": "E0",
					"x-doc": {
						"zh": "证据等级（E0 单模型，E1 独立双求解器，E2 文献/公开数据，E3 真实实测）",
						"en": "Evidence level (E0 single model, E1 dual independent solvers, E2 literature/public data, E3 real measurement)"
					}
				},
				"basis": {
					"type": "array",
					"items": {
						"type": "string"
					},
					"x-doc": {
						"zh": "证据依据来源列表",
						"en": "List of evidence/verification sources"
					}
				},
				"downgraded": {
					"type": "boolean",
					"x-doc": {
						"zh": "是否已被降级",
						"en": "Whether the evidence level has been downgraded"
					}
				},
				"downgrade_reason": {
					"type": "string",
					"x-doc": {
						"zh": "降级原因",
						"en": "Reason for evidence downgrade"
					}
				},
				"claims": {
					"type": "object",
					"description": "Per-metric or per-claim evidence levels and downgrade status",
					"additionalProperties": {
						"type": "object",
						"required": ["level"],
						"additionalProperties": false,
						"properties": {
							"level": {
								"type": "string",
								"enum": ["E0", "E1", "E2", "E3"]
							},
							"basis": {
								"type": "array",
								"items": {
									"type": "string"
								}
							},
							"downgraded": {
								"type": "boolean"
							},
							"downgrade_reason": {
								"type": "string"
							}
						}
					}
				}
			}
		},
		"audit": {
			"$ref": "#/$defs/SimulationAudit",
			"x-doc": {
				"zh": "版本化仿真审计；缺少参考适用性证据保持未验证，并保留旧审计对照。",
				"en": "Versioned simulation audit; missing applicability stays unverified, with the legacy result retained."
			}
		},
		"audit_observation": {
			"$ref": "#/$defs/AuditObservation",
			"x-doc": {
				"zh": "驱动阶段逐步累计的支撑与峰值证据，不依赖轨迹记录频率。旧记录缺失时保持未知，不补造。",
				"en": "Support and peak evidence accumulated at every driven step, independently of telemetry cadence. Missing historical coverage remains unknown and is never synthesized."
			}
		}
	},
	"$defs": {
		"Ulid": {
			"type": "string",
			"pattern": "^[0-7][0-9A-HJKMNP-TV-Z]{25}$",
			"x-doc": {
				"zh": "稳定的资产 ID（ULID，26 个字符，按创建时间可排序）",
				"en": "Stable asset id (ULID: 26 characters, sortable by creation time)"
			}
		},
		"ExecutionIdentity": {
			"type": "object",
			"additionalProperties": false,
			"required": ["key_format", "simulation_semantics", "status"],
			"description": "Versioned simulation identity. Verified installed bytes and runtime are required for cache reuse.",
			"properties": {
				"key_format": {
					"const": 2,
					"x-doc": {
						"zh": "实现感知的缓存键版本",
						"en": "Implementation-aware cache key format"
					}
				},
				"simulation_semantics": {
					"type": "string",
					"minLength": 1,
					"x-doc": {
						"zh": "能量、观测、事件、证据与多配置汇总的语义版本",
						"en": "Semantic version for energy, observations, events, evidence and ensemble aggregation"
					}
				},
				"status": {
					"enum": ["verified", "unavailable"],
					"x-doc": {
						"zh": "能否核验实际执行的实现",
						"en": "Whether the executing implementation can be verified"
					}
				},
				"implementation_hash": {
					"type": "string",
					"pattern": "^sha256:[0-9a-f]{64}$",
					"x-doc": {
						"zh": "已安装文件与运行依赖清单的内容哈希",
						"en": "Content hash of the installed files and runtime manifest"
					}
				},
				"manifest": {
					"type": "object",
					"additionalProperties": false,
					"required": ["files", "runtime"],
					"properties": {
						"files": {
							"type": "object",
							"minProperties": 1,
							"additionalProperties": {
								"type": "string",
								"pattern": "^sha256:[0-9a-f]{64}$"
							},
							"x-doc": {
								"zh": "相对安装路径到文件内容哈希；不包含本机绝对路径",
								"en": "Installation-relative file names and content hashes, without host absolute paths"
							}
						},
						"runtime": {
							"type": "object",
							"minProperties": 1,
							"additionalProperties": {
								"type": "string"
							},
							"x-doc": {
								"zh": "Python、数值依赖版本及计算线程配置",
								"en": "Python and numerical dependency versions, and numerical thread settings"
							}
						}
					}
				},
				"reason": {
					"enum": [
						"implementation_unavailable",
						"implementation_changed_since_import",
						"runtime_bindings_changed",
						"implementation_changed_during_run"
					],
					"x-doc": {
						"zh": "无法安全复用缓存的原因代码",
						"en": "Reason code explaining why cache reuse is unavailable"
					}
				}
			},
			"oneOf": [
				{
					"properties": {
						"status": {
							"const": "verified"
						}
					},
					"required": ["implementation_hash", "manifest"],
					"not": {
						"required": ["reason"]
					}
				},
				{
					"properties": {
						"status": {
							"const": "unavailable"
						}
					},
					"required": ["reason"],
					"not": {
						"anyOf": [
							{
								"required": ["implementation_hash"]
							},
							{
								"required": ["manifest"]
							}
						]
					}
				}
			]
		},
		"SimulationAudit": {
			"type": "object",
			"additionalProperties": false,
			"required": [
				"version",
				"status",
				"passed",
				"scope",
				"physical_validation_implied",
				"thresholds",
				"findings",
				"stride_reference",
				"legacy"
			],
			"properties": {
				"version": {
					"const": 2
				},
				"status": {
					"enum": ["passed", "failed", "unverified"]
				},
				"passed": {
					"type": "boolean"
				},
				"scope": {
					"const": "numerical_invariants_and_applicable_geometric_reference"
				},
				"physical_validation_implied": {
					"const": false
				},
				"thresholds": {
					"type": "object",
					"additionalProperties": false,
					"required": [
						"energy_residual",
						"loop_open_m",
						"penetration_m",
						"stride_relative"
					],
					"properties": {
						"energy_residual": {
							"const": 0.02
						},
						"loop_open_m": {
							"const": 0.005
						},
						"penetration_m": {
							"const": 0.005
						},
						"stride_relative": {
							"const": 0.15
						}
					}
				},
				"findings": {
					"type": "array",
					"items": {
						"type": "object",
						"additionalProperties": false,
						"required": ["check", "message", "evidence"],
						"properties": {
							"check": {
								"type": "string"
							},
							"message": {
								"type": "string"
							},
							"evidence": {
								"type": "object"
							}
						}
					}
				},
				"stride_reference": {
					"type": "object",
					"additionalProperties": false,
					"required": [
						"model",
						"signed_stride_m_per_rev",
						"numerically_resolved",
						"applicability",
						"conditions",
						"comparison"
					],
					"properties": {
						"model": {
							"const": "lowest-foot-sphere-v1"
						},
						"signed_stride_m_per_rev": {
							"type": ["number", "null"],
							"x-unit": "m"
						},
						"numerically_resolved": {
							"type": "boolean"
						},
						"error": {
							"type": "string"
						},
						"owners": {
							"type": "array",
							"items": {
								"type": "object",
								"additionalProperties": false,
								"required": ["leg", "start", "end", "radius_m"],
								"properties": {
									"leg": {
										"type": "integer",
										"minimum": 0,
										"x-unit": "count"
									},
									"start": {
										"type": "string"
									},
									"end": {
										"type": "string"
									},
									"radius_m": {
										"type": "number",
										"x-unit": "m"
									}
								}
							}
						},
						"resolutions": {
							"type": "array",
							"items": {
								"type": "integer",
								"minimum": 2,
								"x-unit": "count"
							}
						},
						"samples": {
							"type": "array",
							"items": {
								"type": "object"
							}
						},
						"resolution_relative_difference": {
							"type": ["number", "null"],
							"x-unit": "1"
						},
						"resolution_relative_tolerance": {
							"type": "number",
							"x-unit": "1"
						},
						"applicability": {
							"enum": ["verified", "unverified"]
						},
						"conditions": {
							"type": "array",
							"minItems": 1,
							"items": {
								"type": "object",
								"additionalProperties": false,
								"required": ["code", "status", "evidence"],
								"properties": {
									"code": {
										"type": "string"
									},
									"status": {
										"enum": ["verified", "unverified"]
									},
									"evidence": {
										"type": "object"
									}
								}
							}
						},
						"comparison": {
							"type": "object",
							"additionalProperties": false,
							"required": [
								"relative_error",
								"relative_tolerance",
								"diagnostic_only"
							],
							"properties": {
								"relative_error": {
									"type": ["number", "null"],
									"x-unit": "1"
								},
								"relative_tolerance": {
									"const": 0.15
								},
								"diagnostic_only": {
									"type": "boolean"
								}
							}
						}
					},
					"allOf": [
						{
							"if": {
								"properties": {
									"applicability": {
										"const": "verified"
									}
								}
							},
							"then": {
								"properties": {
									"numerically_resolved": {
										"const": true
									},
									"signed_stride_m_per_rev": {
										"type": "number",
										"not": {
											"const": 0
										}
									},
									"conditions": {
										"items": {
											"properties": {
												"status": {
													"const": "verified"
												}
											}
										}
									},
									"comparison": {
										"properties": {
											"diagnostic_only": {
												"const": false
											}
										}
									}
								}
							}
						}
					]
				},
				"legacy": {
					"type": "object",
					"additionalProperties": false,
					"required": ["version", "passed", "findings"],
					"properties": {
						"version": {
							"const": 1
						},
						"passed": {
							"type": "boolean"
						},
						"findings": {
							"type": "array",
							"items": {
								"type": "object",
								"additionalProperties": false,
								"required": ["check", "message", "evidence"],
								"properties": {
									"check": {
										"type": "string"
									},
									"message": {
										"type": "string"
									},
									"evidence": {
										"type": "object"
									}
								}
							}
						}
					}
				}
			},
			"allOf": [
				{
					"if": {
						"properties": {
							"status": {
								"const": "passed"
							}
						}
					},
					"then": {
						"properties": {
							"passed": {
								"const": true
							},
							"findings": {
								"maxItems": 0
							},
							"stride_reference": {
								"properties": {
									"applicability": {
										"const": "verified"
									}
								}
							}
						}
					},
					"else": {
						"properties": {
							"passed": {
								"const": false
							},
							"findings": {
								"minItems": 1
							}
						}
					}
				}
			]
		},
		"AuditObservation": {
			"type": "object",
			"additionalProperties": false,
			"required": [
				"version",
				"scope",
				"boundary",
				"timestep_s",
				"legs",
				"support_force_N",
				"integration_steps",
				"observed_steps",
				"invalid_steps",
				"time_gap_steps",
				"airborne_steps",
				"first_time_s",
				"last_time_s",
				"max_loop_residual_m",
				"max_penetration_m"
			],
