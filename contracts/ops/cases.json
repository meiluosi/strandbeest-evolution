{
	"_doc": "Operation cases: apply ops to a base design; expect the exact patch from base to result, or the rejection. Both runners must agree. Regenerate with generate_cases.py.",
	"cases": [
		{
			"name": "set_param changes one length",
			"base": {
				"design": "schemas/examples/design-jansen-small-6leg.json"
			},
			"ops": [
				{
					"type": "set_param",
					"args": {
						"name": "m",
						"value": 14.0
					}
				}
			],
			"expect": {
				"patch": [
					{
						"op": "replace",
						"path": "/linkage/params/m",
						"value": 14.0
					}
				]
			}
		},
		{
