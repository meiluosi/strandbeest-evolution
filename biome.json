{
	"formatter": {
		"indentStyle": "tab"
	},
	"javascript": {
		"formatter": {
			"quoteStyle": "double"
		}
	},
	"linter": {
		"enabled": true,
		"rules": {
			"preset": "none"
		}
	},
	"files": {
		"includes": [
			"**",
			"!**/node_modules",
			"!**/dist",
			"!experiments",
			"!packages/sim",
			"!.venv",
			"!apps/api",
			"!packages/common",
			"!packages/fab",
			"!packages/calib",
			"!packages/rig",
			"!hardware"
		]
	}
}
